{
  "name": "electron-conveyor",
  "version": "0.2.0",
  "description": "Type-safe IPC and cross-window state for Electron \u2014 single source of truth per feature, end-to-end inference.",
  "keywords": [
    "electron",
    "ipc",
    "type-safe",
    "typescript",
    "rpc",
    "trpc",
    "cross-window",
    "state",
    "preload",
    "context-bridge",
    "react",
    "electron-conveyor",
    "conveyor"
  ],
  "license": "MIT",
  "author": {
    "name": "Guasam",
    "url": "https://github.com/guasam"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guasam/electron-conveyor.git"
  },
  "homepage": "https://github.com/guasam/electron-conveyor#readme",
  "bugs": {
    "url": "https://github.com/guasam/electron-conveyor/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./define": {
      "import": {
        "types": "./dist/define.d.ts",
        "default": "./dist/define.js"
      },
      "require": {
        "types": "./dist/define.d.cts",
        "default": "./dist/define.cjs"
      }
    },
    "./main": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/preload.d.ts",
        "default": "./dist/preload.js"
      },
      "require": {
        "types": "./dist/preload.d.cts",
        "default": "./dist/preload.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "electron": ">=30",
    "react": ">=18",
    "zod": "^4",
    "zustand": "^5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "electron": "^43.0.0",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
